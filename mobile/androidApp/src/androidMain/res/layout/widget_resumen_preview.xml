<?xml version="1.0" encoding="utf-8"?>
<!-- Vista previa estática del widget en el selector del launcher (API 31+, W-02).
     Mismo contenido que pinta Glance: gasto del mes y próximo cobro. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/widget_resumen_preview_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_monthly_label"
        android:textColor="#5B21B6"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="83,98 €"
        android:textColor="#5B21B6"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Netflix · 12,99 €"
        android:textColor="#5B21B6"
        android:textSize="12sp" />
</LinearLayout>
