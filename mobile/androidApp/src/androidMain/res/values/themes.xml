<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Debe heredar de Theme.AppCompat: MainActivity extiende AppCompatActivity
         (necesario para AppCompatDelegate del selector de idioma i18n). Con un tema
         del framework (android:Theme.Material) la app crashea al iniciar con
         "You need to use a Theme.AppCompat theme". -->
    <style name="Theme.SubIA" parent="Theme.AppCompat.Light.NoActionBar" />

    <!-- Tema de arranque (androidx.core:core-splashscreen). El manifest apunta la Activity aquí;
         MainActivity llama a installSplashScreen() y el sistema salta a postSplashScreenTheme.
         El icono es el adaptativo del launcher (fondo + escudo), así el splash coincide con el
         icono del cajón. El fondo claro/oscuro se define en values/ y values-night/ para evitar
         el flash blanco -> negro al entrar en la app en modo oscuro. -->
    <style name="Theme.SubIA.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.SubIA</item>
    </style>
</resources>
