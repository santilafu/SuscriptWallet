<?xml version="1.0" encoding="utf-8"?>
<!-- Icono adaptativo con el logo 2026 (tarjetas + S + monedas sobre degradado). El primer plano es
     opaco: el logo a 70 dp y el degradado prolongado hasta el borde de 108 dp, así que el fondo
     sólido solo se ve durante la animación de lanzamiento. Monochrome: tarjeta con la S recortada.
     Se regenera con mobile/tools/icons/compose_logo_2026.py a partir de logo_fuente_2026.png. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
